      "conditionRef": "urn:proofline:session-recorder:Condition:recording-microphone-permission-required",
      "effectRef": "urn:proofline:session-recorder:Effect:open-microphone-permission-tab",
      "toEntryRef": "urn:proofline:session-recorder:JourneyEntry:microphone-open"
    },
    {
      "@id": "urn:proofline:session-recorder:Transition:recorder-microphone-permission-granted",
