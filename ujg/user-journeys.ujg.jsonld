      "label": "Comment dictation is requested with a configured transcription provider and no stored extension microphone grant."
    },
    {
      "@id": "urn:proofline:session-recorder:Effect:open-microphone-permission-tab",
      "@type": "Effect",
      "label": "Open the visible microphone permission page and retain the originating microphone action while awaiting its exported outcome."
