      "to": "urn:proofline:session-recorder:State:recorder-recording",
      "fromExitRef": "urn:proofline:session-recorder:JourneyExit:microphone-denied"
    },
    {
      "@id": "urn:proofline:session-recorder:Transition:recorder-microphone-permission-timeout",
